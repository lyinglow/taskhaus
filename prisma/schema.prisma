// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Parent {
  id        Int     @id @default(autoincrement())
  name      String
  email     String  @unique
  phone     String?
  address   String?
  passwordHash String
  marketingOptIn   Boolean   @default(false)
  marketingOptInAt DateTime?
  failedLoginAttempts Int @default(0)
  loginLockedUntil   DateTime?
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt DateTime @default(now())

  jobs     Job[]
  reviews  Review[]
  payments Payment[]
  feedback Feedback[]
}

model CrewMember {
  id        Int     @id @default(autoincrement())
  name      String
  age       Int?
  skills    String?
  isAvailable Boolean @default(true)
  pinHash   String?
  failedPinAttempts Int @default(0)
  pinLockedUntil   DateTime?
  createdAt DateTime @default(now())

  jobs     Job[]
  payments Payment[]
}

model Service {
  id        Int     @id @default(autoincrement())
  name      String
  description String? // short description, shown on service cards
  longDescription String? // long description, shown on the service detail/booking page
  toolsNeeded String? // tools/equipment crew need, shown on the crew portal
  serviceType String @default("fixed") // "fixed" or "quote"
  category  String  @default("garden") // "garden" or "other"
  price     Float?
  isActive  Boolean @default(true)
  requiresPhotoReview Boolean @default(true) // whether crew must mark job "ready for review" with an after photo before admin can complete it
  partnerCredit String? // e.g. "Tools provided by Acme Hardware" - shown on the service card
  season String? // e.g. "Spring - Autumn" or "Year-round" - when the service can be booked
  createdAt DateTime @default(now())

  jobs     Job[]
  reviews  Review[]
  extras   ServiceExtra[]
}

model ServiceExtra {
  id        Int     @id @default(autoincrement())
  serviceId Int
  name      String
  price     Float
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())

  service   Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  jobExtras JobExtra[]
}

model Job {
  id              Int     @id @default(autoincrement())
  parentId        Int
  serviceId       Int?
  crewMemberId    Int?
  customRequest   String?
  status          String  @default("pending") // pending, quoted, confirmed, completed
  quotedPrice     Float?
  finalPrice      Float?
  notes           String?
  timeWindow      String?
  jobDate         DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  recurrence      String? // null, "weekly", "biweekly", "monthly"
  photoBeforeUrl  String?
  photoAfterUrl   String?

  parent       Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)
  service      Service? @relation(fields: [serviceId], references: [id])
  crewMember   CrewMember? @relation(fields: [crewMemberId], references: [id])
  review       Review?
  payments     Payment[]
  extras       JobExtra[]
}

model JobExtra {
  id             Int     @id @default(autoincrement())
  jobId          Int
  serviceExtraId Int?
  name           String // snapshot at time of booking
  price          Float  // snapshot at time of booking

  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  serviceExtra ServiceExtra? @relation(fields: [serviceExtraId], references: [id], onDelete: SetNull)
}

model Review {
  id        Int     @id @default(autoincrement())
  jobId     Int     @unique
  serviceId Int
  parentId  Int
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  job     Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  parent  Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

model AdminLoginAttempt {
  id             Int       @id @default(autoincrement())
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
}

model Payment {
  id              Int     @id @default(autoincrement())
  jobId           Int
  crewMemberId    Int
  parentId        Int
  amount          Float
  status          String  @default("pending") // pending, completed
  paidDate        DateTime?
  createdAt       DateTime @default(now())

  job       Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  crewMember CrewMember @relation(fields: [crewMemberId], references: [id])
  parent    Parent @relation(fields: [parentId], references: [id])
}

model Feedback {
  id              Int      @id @default(autoincrement())
  parentId        Int?
  name            String?
  email           String?
  appFeedback     String?
  serviceFeedback String?
  qualityFeedback String?
  otherFeedback   String?
  createdAt       DateTime @default(now())

  parent Parent? @relation(fields: [parentId], references: [id], onDelete: SetNull)
}

model PartnerInquiry {
  id           Int      @id @default(autoincrement())
  businessName String
  contactName  String
  email        String
  phone        String?
  offerTypes   String? // comma-separated: tools, materials, discounts, other
  message      String?
  createdAt    DateTime @default(now())
}
